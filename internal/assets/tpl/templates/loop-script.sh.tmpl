#!/bin/bash
#
# Context: Ralph Loop Script
# Generated by: ctx loop
#
# This script runs an AI assistant in a loop until completion.
# The AI works on the same prompt file repeatedly, building on
# previous work visible in files and git history.
#

set -e

PROMPT_FILE="{{.PromptFile}}"
COMPLETION_SIGNAL="{{.CompletionSignal}}"
ITERATION=0

echo "Starting Ralph Loop"
echo "==================="
echo "Prompt: $PROMPT_FILE"
{{if or .IsEoCC .IsSAC}}echo "Regime: {{.Regime}}"
{{end}}echo "Completion signal: $COMPLETION_SIGNAL"
echo ""

# Ensure prompt file exists
if [ ! -f "$PROMPT_FILE" ]; then
    echo "Error: Prompt file not found: $PROMPT_FILE"
    exit 1
fi

while true; do
    ITERATION=$((ITERATION + 1))
    echo ""
    echo "=== Iteration $ITERATION ==="
    echo ""

{{if .MaxIter}}    # Check iteration limit
    if [ $ITERATION -ge {{.MaxIter}} ]; then
        echo "Reached maximum iterations ({{.MaxIter}})"
        ctx hook notify --event loop "Loop completed after $ITERATION iterations" 2>/dev/null || true
        break
    fi
{{end}}{{if or .IsEoCC .IsSAC}}    # Assemble semantic state packet (EoCC / SAC)
    STATE_PACKET=$(ctx agent --budget 4000 2>/dev/null || true)
    ITER_PROMPT="$(cat "$PROMPT_FILE")

---
# Semantic State Packet (ctx agent)
$STATE_PACKET

---
{{if .IsSAC}}# Single-Action Compaction (SAC) Contract
1. Review the Semantic State Packet and Latest Session Handover above.
2. Execute at most ONE environment action (one edit, command, or test run) and observe its outcome.
3. Immediately persist the updated execution brief before exiting this iteration:
   ctx handover write \"<title>\" --no-fold --summary \"...\" --facts \"...\" --verified \"...\" --dead-ends \"...\" --next \"...\"
4. Emit $COMPLETION_SIGNAL only when all completion criteria are verified.{{else}}# End-of-Conversation Compaction (EoCC) Contract
1. Review the Semantic State Packet and Latest Session Handover above and continue from its Next Session step.
2. Before exiting this iteration, persist the updated execution brief:
   ctx handover write \"<title>\" --no-fold --summary \"...\" --facts \"...\" --verified \"...\" --dead-ends \"...\" --next \"...\"
3. Emit $COMPLETION_SIGNAL only when all completion criteria are verified.{{end}}"
{{end}}    # Run the AI tool
    OUTPUT=$({{.AICommand}} 2>&1) || true

    echo "$OUTPUT"

    # Check for completion signal
    if echo "$OUTPUT" | grep -q "$COMPLETION_SIGNAL"; then
        echo ""
        echo "{{.LoopComplete}}"
        echo "Detected completion signal: $COMPLETION_SIGNAL"
        echo "Total iterations: $ITERATION"
        ctx hook notify --event loop "Loop completed after $ITERATION iterations" 2>/dev/null || true
        break
    fi

    # Small delay to prevent runaway loops
    sleep 1
done
