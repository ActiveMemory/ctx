{
  "ctx": {
    "SessionStart": [
      {
        "type": "command",
        "command": "ctx system context-load-gate"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "ctx system check-context-size"
      },
      {
        "type": "command",
        "command": "ctx system check-ceremony"
      },
      {
        "type": "command",
        "command": "ctx system check-persistence"
      },
      {
        "type": "command",
        "command": "ctx system check-journal"
      },
      {
        "type": "command",
        "command": "ctx system check-reminder"
      },
      {
        "type": "command",
        "command": "ctx system check-version"
      },
      {
        "type": "command",
        "command": "ctx system check-resource"
      },
      {
        "type": "command",
        "command": "ctx system check-knowledge"
      },
      {
        "type": "command",
        "command": "ctx system check-map-staleness"
      },
      {
        "type": "command",
        "command": "ctx system check-memory-drift"
      },
      {
        "type": "command",
        "command": "ctx system check-freshness"
      },
      {
        "type": "command",
        "command": "ctx system check-skill-discovery"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "ctx system block-non-path-ctx"
          },
          {
            "type": "command",
            "command": "ctx system qa-reminder"
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "ctx system specs-nudge"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "ctx system post-commit"
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "ctx system check-task-completion"
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "ctx system heartbeat"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "ctx system session-event --type end --caller agy"
      }
    ]
  }
}
